# Server
PORT=3000

# Target GitHub repository (a private repository is recommended)
GITHUB_OWNER=your-username
GITHUB_REPO=your-archive-repository
GITHUB_BRANCH=main

# Use a fine-grained token with Contents: Read and write on this repository only.
# You can use GH_TOKEN from the environment instead of writing it here.
GITHUB_TOKEN=replace-with-your-token

# GitHub Contents API limit used by this app: 1–100 MiB
MAX_FILE_SIZE_MB=100
